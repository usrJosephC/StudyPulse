# Copy to .env and use the URL + public key of your Supabase project.
# For Android emulator, local Supabase normally uses http://10.0.2.2:54321.
# For a physical device, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for projects using legacy public anon keys:
EXPO_PUBLIC_SUPABASE_ANON_KEY=
